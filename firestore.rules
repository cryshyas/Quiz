rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 학생 진행 상태 컬렉션
    match /students/{studentDoc} {
      // 익명 로그인된 학생 및 교사 누구나 읽고 쓸 수 있도록 허용
      allow read, write: if request.auth != null;
    }

    // 오답 누적 통계 컬렉션
    match /stats/{statDoc} {
      allow read, write: if request.auth != null;
    }

    // 기타 문서는 기본 차단
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
